# Path to the SBD library
SBD_PATH=../..

# MPI C++ compiler wrapper (conda openmpi)
CCCOM=mpicxx

# CPU-only build, Apple Silicon (arm64), conda clang + llvm-openmp
CCFLAGS = -O3 -std=c++17 -fopenmp -DSBD_TRADMODE

# Link line: OpenMP runtime (via mpicxx's own environment-relative rpath,
# no explicit -L needed -- verified by removing the previous hardcoded
# -L/Users/<user>/miniforge3/envs/<env>/lib path and confirming diag still
# builds and runs) + macOS Accelerate for LAPACK/BLAS
SYSLIB = -lomp -framework Accelerate
